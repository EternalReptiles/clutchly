{
  "expo": {
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fcfcf8"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#141414"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fcfcf8"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#fcfcf8",
    "primaryColor": "#141414",
    "icon": "./assets/icon.png",
    "owner": "eternalreptiles01",
    "extra": {
      "eas": {
        "projectId": "44959b1a-93d3-438d-a00c-eead79453e3f"
      }
    }
  }
}
