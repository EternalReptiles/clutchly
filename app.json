{
  "expo": {
    "name": "Clutchly",
    "slug": "clutchly",
    "scheme": "clutchly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "bundleIdentifier": "com.eternalreptiles.clutchly",
      "supportsTablet": true
    },
    "android": {
      "package": "com.eternalreptiles.clutchly"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    }
  }
}
